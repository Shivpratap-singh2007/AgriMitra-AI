# ==============================================================================
# AgriMitra AI 2.0 — Environment Configuration Example (Placeholders Only)
# ==============================================================================

# Server Network Configuration
HOST=127.0.0.1
PORT=5001

# Persistent SQLite Database Location
# Uses SQLite with thread-safe Write-Ahead Logging (WAL) mode
DATABASE_PATH=backend/data/agrimitra_v2.db

# IoT Microcontroller Device Authentication
# Secret key matched against X-Device-Key header from the ESP32
DEVICE_SECRET_KEY=your_esp32_secret_device_key_here

# Google Gemini API Key
# Used for multimodal visual reasoning and bilingual farmer chatbot
# Obtain a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Agro-Meteorological Satellite Weather Feed
# Open-Meteo satellite feed is active by default and requires NO key.
# Optional OpenWeatherMap API key if custom provider selected:
WEATHER_API_KEY=

# Frontend Configuration
VITE_API_BASE_URL=http://127.0.0.1:5001/api

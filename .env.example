# AgriMitra AI – Simple AI Crop Doctor Configuration
# Server Port (Default: 5001)
PORT=5001

# Google Gemini API Key (Required for live leaf disease diagnosis and AI Farmer Chatbot)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
AI_API_KEY=

# OpenWeatherMap API Key (Optional - Open-Meteo satellite feed is 100% free and requires NO key)
WEATHER_API_KEY=

# Supabase Cloud Database (Optional - Built-in SQLite local database is active by default)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=

{
  "name": "agrimitra-ai",
  "version": "1.0.0",
  "private": true,
  "description": "AgriMitra AI - Smart Polyhouse & Farm Response Intelligence Platform",
  "main": "electron/main.js",
  "scripts": {
    "start": "python start.py",
    "start:local": ".venv\\Scripts\\python.exe start.py",
    "start:prod": "python start.py",
    "dev:backend": "python start.py",
    "dev:frontend": "npm run dev --prefix frontend",
    "install:frontend": "npm install --prefix frontend",
    "build:frontend": "npm --prefix frontend install && npm --prefix frontend run build",
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
    "electron": "npx electron electron/main.js",
    "electron:pack": "npx electron-builder --dir",
    "electron:dist": "npx electron-builder --win"
  },
  "build": {
    "appId": "com.agrimitra.ai",
    "productName": "AgriMitra AI",
    "copyright": "Copyright © 2026 AgriMitra AI",
    "directories": {
      "output": "dist_electron"
    },
    "win": {
      "target": ["nsis"],
      "icon": "frontend/public/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AgriMitra AI"
    },
    "files": [
      "electron/**/*",
      "backend/**/*",
      "frontend/dist/**/*",
      "package.json"
    ]
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "electron": "^36.3.2",
    "electron-builder": "^26.0.12"
  }
}
